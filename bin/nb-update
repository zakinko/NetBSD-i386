#!/bin/sh
#
# CI が作ったバイナリパッケージで、この箱を更新する。NetBSD 側で走らせる。
#
#	nb-update setup    pkgin のリポジトリ設定を入れる (初回)
#	nb-update check    何が上がるかだけ見る。何も変えない。
#	nb-update          更新する
#
# pkgsrc ツリーは要らない。この箱でソースを引くことはもうない。
#
# ここでやらないこと:
#   /etc/mk.conf の配布   ~/.sbin/pkgsrc-fix-mkconf.sh の仕事
#   audit                 ~/.sbin/pkgsrc-audit.sh の仕事 (make audit)
# 正は ~/.sbin。二つの道具が同じファイルを書きに行くと、どちらが正か
# 分からなくなるので、こちらは pkgin まわりだけに絞ってある。

set -eu

# pkgin も pkg_admin も対話シェル以外の PATH には入っていない。cron から
# 呼ぶことも考えて、ここで揃えておく。
PATH=/usr/pkg/sbin:/usr/pkg/bin:/sbin:/usr/sbin:/bin:/usr/bin
export PATH

: "${REPO_OWNER:=zakinko}"
: "${REPO_NAME:=NetBSD-i386}"

# 箱ごとに OS のリリースが違う (9.4 / 10.1 / 11.0)。リリースが変われば
# libc のメジャーが変わるので、他のリリース向けのバイナリは動かない。
# この箱のリリースとアーキから、見に行くタグを自分で決める。
#
# uname -r は 11.0_STABLE のような形になることがあるので、頭の x.y だけ取る。
: "${NETBSD_RELEASE:=$(uname -r | sed -e 's/[^0-9.].*$//' -e 's/\.$//')}"
: "${NETBSD_ARCH:=$(uname -m)}"
: "${RELEASE_TAG:=pkgsrc-${NETBSD_RELEASE}-${NETBSD_ARCH}}"
REPO_URL=${REPO_URL:-https://github.com/$REPO_OWNER/$REPO_NAME/releases/download/$RELEASE_TAG}

PKG_DBDIR=${PKG_DBDIR:-/var/db/pkg}
PKG_PREFIX=${PKG_PREFIX:-/usr/pkg}
PKGIN_CONF=$PKG_PREFIX/etc/pkgin/repositories.conf

export PKG_DBDIR

warn() { echo "nb-update: $*" >&2; }
die()  { warn "$*"; exit 1; }

need_root() {
	[ "$(id -u)" = 0 ] || die "root で走らせること (sudo nb-update ...)"
}

do_setup() {
	need_root

	echo "この箱: NetBSD $NETBSD_RELEASE/$NETBSD_ARCH → $RELEASE_TAG"

	# 向こうにそのリリースのタグが無いのに設定だけ入れると、pkgin が
	# 空のリポジトリを見て黙って何もしなくなる。先に確かめる。
	if ! ftp -o /dev/null "$REPO_URL/pkg_summary.xz" 2>/dev/null; then
		warn "$REPO_URL に pkg_summary.xz が無い"
		warn "そのリリース向けが CI で作られていない見込み。"
		warn ".github/workflows/build.yml の matrix に $NETBSD_RELEASE があるか確認すること。"
		die "設定を入れずに止める"
	fi

	[ -d "$PKG_PREFIX/etc/pkgin" ] || mkdir -p "$PKG_PREFIX/etc/pkgin"

	if grep -q "^$REPO_URL\$" "$PKGIN_CONF" 2>/dev/null; then
		echo "repositories.conf は既に $REPO_URL を見ている"
	else
		if [ -f "$PKGIN_CONF" ]; then
			cp "$PKGIN_CONF" "$PKGIN_CONF.bak.$(date +%Y%m%d%H%M%S)"
			# 公式のリポジトリと混ぜると、mk.conf のオプションが効いて
			# いない方のバイナリを掴むことがある。既存行は畳んでおく。
			# sed -i の方言に踏み込まないよう一時ファイルを経由する。
			sed 's/^\([^#]\)/#\1/' "$PKGIN_CONF" >"$PKGIN_CONF.new"
			mv "$PKGIN_CONF.new" "$PKGIN_CONF"
		fi
		echo "$REPO_URL" >>"$PKGIN_CONF"
		echo "repositories.conf に $REPO_URL を足した"
	fi

	echo
	echo "/etc/mk.conf は ~/.sbin/pkgsrc-fix-mkconf.sh が配る。こちらでは触らない。"
	echo "この後は 'nb-update check' で様子を見てから 'nb-update' を叩く。"
}

do_check() {
	pkgin update
	echo
	echo "--- 上がるもの"
	pkgin -n full-upgrade || true
}

do_update() {
	need_root
	pkgin -y update
	pkgin -y full-upgrade
	echo
	echo "audit は ~/.sbin で 'make audit' (pkgsrc-audit.sh)。"
	echo "何が上流待ちで何が設定で消せるかは doc/audit.md にある。"
}

case "${1:-update}" in
setup)		do_setup ;;
check)		do_check ;;
update|'')	do_update ;;
-h|--help|help)
	sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
	;;
*)
	die "知らない指定: $1  (setup / check / update)"
	;;
esac
