#!/bin/sh
#
# send-pr へ出す前に、当て物が本当に足りているかを機械で見る。
#
#	pr-ready <pkgdir> [<pkgdir> ...]
#	pr-ready --diff <差分>		本文に貼る diff そのものを見る
#
# 散文の規則は、書く瞬間には効かない。実際に外していたのは次の四つで、
# どれも人の注意力ではなく確認の手順が抜けていた。
#
#   - 当て物を素の distfile に当ててみていない
#   - distinfo の値が当て物と合っていない
#   - 変えた変数を木の中で grep していない (他にも使う側が居る)
#   - 値の置き場を変えたのに、その値を shell へ渡している所を見ていない
#   - fork の $NetBSD$ を書き換えたまま、上流への差分に混ぜた
#
# math/calc で最後の一つを踏んだ。/tmp から $HOME の下へ移したが、その名前を
#
#	"-c" (format "cat %s >/dev/tty; rm %s" output output)
#
# へ引用符なしで渡す関数が在り、/tmp の頃は絶対に壊れなかったものが、home の
# path に空白が入ると壊れる形になっていた。移す変更が、別の潜在バグを踏ませた。
#
# 落ちたら送らない。通っても「建てた」ことにはならないので、build の確認は
# 別に要る。ここが見るのは静的に見えるところだけである。

# --diff は五つめのために在る。こちらの fork は新しい file として作るので
# $NetBSD$ と書くが、上流の file はその位置に展開済みの Id 行を持っている。
# そのまま差分を取ると Id 行が全部 hunk になり、当たらないうえに雑に見える。
# 実際に 17 個を並べたとき 36 file がそうなっていた。
#
# あわせて、patch は file を消せないことも見る。中身が空になる hunk は
# 「消す」意図なので、本文に cvs rm と書いていなければ committer に伝わらない。

set -eu

# 見る物は byte として扱う。pkgsrc の当て物は UTF-8 とは限らず、anthy の辞書は
# EUC-JP である。UTF-8 の locale のまま awk に食わせると
#
#	awk: towc: multibyte conversion failure on: '...'
#
# と言って **その file の残りを読まずに抜ける**。落ちるのではなく、短い答えを
# 返す。実際 inputmethod/anthy の diff で「新しい file」が 5 本のところ 2 本
# しか出さず、rc は 0 のままだった。cvs add を書き漏らす形の事故になる。
LC_ALL=C; export LC_ALL

# 一時 file の置き場。TMPDIR が在ればそちらを使う。
TMP=${TMPDIR:-/tmp}

: "${PKGSRCDIR:=/usr/pkgsrc}"
: "${PKGLINT:=/usr/pkg/bin/pkglint}"

fail=0
note() { printf '  %s\n' "$*"; }
bad()  { printf '  ★ %s\n' "$*"; fail=1; }

check_one() {
	pkg=$1
	printf '=== %s\n' "$pkg"
	[ -d "$pkg" ] || { bad "そんなディレクトリは無い"; return; }

	# 1. 当て物に説明があるか
	if [ -d "$pkg/patches" ]; then
		for p in "$pkg"/patches/patch-*; do
			[ -f "$p" ] || continue
			if ! awk 'NR>1 && /^--- /{exit} NR>1 && /[A-Za-z]/{f=1} END{exit !f}' "$p"
			then bad "説明が無い: ${p##*/}"; fi
		done
	fi

	# 1a. 当て物の頭が揃っているか。--- と +++ と @@ が一組ずつ要る。
	#     どれかが欠けると patch は当てる先を決められず、対話で
	#
	#		File to patch:
	#		No file found--skip this patch? [n]
	#
	#     を出す。標準入力が無い build では EOF を読んでこれを繰り返し、
	#     止まらない。実際に三時間で 1.9GB のログを吐いて箱を満杯にした。
	#     原因は当て物を別の diff から取り出すとき、外側の diff が付けた
	#     + を剥がす filter が、中身の +++ 行まで落としていたこと。
	if [ -d "$pkg/patches" ]; then
		for p in "$pkg"/patches/patch-*; do
			[ -f "$p" ] || continue
			# grep -c は 0 件で exit 1。set -e の下では代入で落ちる
			m=$(grep -c '^--- ' "$p" 2>/dev/null || true)
			n=$(grep -c '^+++ ' "$p" 2>/dev/null || true)
			h=$(grep -c '^@@ ' "$p" 2>/dev/null || true)
			if [ "$m" -eq 0 ] || [ "$n" -eq 0 ] || [ "$h" -eq 0 ]; then
				bad "頭が欠けている (--- $m, +++ $n, @@ $h): ${p##*/}"
				note "   patch が当てる先を訊きに来て止まらなくなる"
			elif [ "$m" -ne "$n" ]; then
				bad "--- と +++ の数が合わない ($m / $n): ${p##*/}"
			fi
		done
	fi

	# 1b. pkgsrc が飛ばす名前になっていないか。~ で終わるものは編集器の
	#     控えとみなされ、黙って無視される。改名でこれを二本作った。
	if [ -d "$pkg/patches" ]; then
		for p in "$pkg"/patches/*; do
			[ -f "$p" ] || continue
			case ${p##*/} in
			*~|*.orig|*.rej|*.bak)
				bad "pkgsrc が無視する名前: ${p##*/}" ;;
			patch-*) : ;;
			*)	note "当て物らしくない file: ${p##*/}" ;;
			esac
		done
	fi

	# 1c. 同じ file を触る当て物が二本無いか。控えを patches/ の下へ
	#     patch-... という名前で置くと、pkgsrc はそれも当て物として拾う。
	#     makepatchsum が SHA1 まで足してくれるので distinfo の検査も通り、
	#     建てて初めて「Some of the selected build options and/or local
	#     patches may be incompatible」で落ちる。mail/mu で踏んだ。
	if [ -d "$pkg/patches" ]; then
		for p in "$pkg"/patches/patch-*; do
			[ -f "$p" ] || continue
			t=$(sed -n 's|^+++ \([^	 ]*\).*|\1|p' "$p" | head -1)
			[ -n "$t" ] || continue
			printf '%s\t%s\n' "$t" "${p##*/}"
		done | sort > "$pkg/.pr-ready-tgt.$$" 2>/dev/null || true
		dup=$(cut -f1 "$pkg/.pr-ready-tgt.$$" 2>/dev/null | uniq -d)
		if [ -n "$dup" ]; then
			for d in $dup; do
				bad "同じ file を触る当て物が二本ある: $d"
				grep "^$d	" "$pkg/.pr-ready-tgt.$$" | sed 's/^/     /'
			done
			note "   控えなら patches/ の外へ出して distinfo を取り直す"
		fi
		rm -f "$pkg/.pr-ready-tgt.$$"
	fi

	# 2. distinfo の値が当て物と合っているか
	if [ -f "$pkg/distinfo" ] && [ -d "$pkg/patches" ]; then
		for p in "$pkg"/patches/patch-*; do
			[ -f "$p" ] || continue
			n=${p##*/}
			# 名前をそのまま正規表現に置くと、当て物の名前に必ず
			# 入っている "." が任意の一字に化ける。mule2 には
			# patch-src_mcpath.c と patch-src_mcpath_c が並んで
			# 居て、前者の pattern が後者にも当たり、want が二行に
			# なって必ず食い違う。値は合っているのに NG が出た。
			nre=$(printf '%s' "$n" | sed 's/[].[^$*\\]/\\&/g')
			want=$(sed -n "s|^SHA1 ($nre) = ||p" "$pkg/distinfo")
			got=$(grep -v '^\$NetBSD' "$p" | shasum | cut -d' ' -f1)
			[ -n "$want" ] || { bad "distinfo に $n が無い"; continue; }
			[ "$want" = "$got" ] || bad "distinfo の値が違う: $n"
		done
	fi

	# 3. 当て物が触る変数と関数を挙げ、木の中の使う側を数える。
	#    ここは落とすためではなく、見ないまま進めないためにある。
	if [ -d "$pkg/patches" ]; then
		# BSD の sed は BRE の \| を解さないので grep -E で拾う。
		syms=$(cat "$pkg"/patches/patch-* 2>/dev/null \
			| grep -oE '^[-+]\(def(var|custom|un|macro|subst) [a-zA-Z0-9_-]+' \
			| sed 's/.* //' | sort -u)
		for s in $syms; do
			c=$(grep -rl -- "$s" "$PKGSRCDIR"/*/*/ 2>/dev/null | wc -l | tr -d ' ')
			note "触る名前 $s -- 木の中で $c ファイルが持つ"
		done
	fi

	# 4. 値の置き場を変えたなら、shell へ渡す所を見たか。
	#    当て物が defvar の値を書き換えていて、かつ元の木に shell へ流す
	#    書き方が在れば、引用の有無を人が見るまで通さない。
	if [ -d "$pkg/patches" ] && \
	   grep -qE '^\+\(defvar|^\+\s*\(defcustom' "$pkg"/patches/patch-* 2>/dev/null
	then
		w=$(grep -rlE 'shell-file-name|shell-command|call-process-region.*-c' \
			"$pkg" 2>/dev/null | wc -l | tr -d ' ')
		if [ "$w" -gt 0 ]; then
			bad "値の置き場を変えていて、shell へ渡す所が $w 件ある。"
			note "   引用してあるか見て、見たなら PR_READY_SHELL_OK=1 を付けて通す"
			[ "${PR_READY_SHELL_OK:-}" = 1 ] && { fail=0; note "   見たと言われたので通す"; }
		fi
	fi

	# 4b. emacs の共存。--program-transform-name は pkgsrc の Makefile から
	#     bmake と autoconf を通って sed に届くまでに展開が三段あり、
	#     s/$$$$/ と書くと sed には s/$$/ が渡る。BRE の $ は行末の位置な
	#     ので何にも当たらず、rc=0 のまま版の付かない bin/emacs が出来る。
	#     目では二つの綴りが見分けられないので機械に数えさせる。
	case ${pkg##*/} in
	emacs*|xemacs*)
		for f in "$pkg/Makefile" "$pkg/Makefile.common"; do
			[ -f "$f" ] || continue
			l=$(grep -h 'program-transform-name' "$f" 2>/dev/null | head -1)
			[ -n "$l" ] || continue
			case "$l" in
			*'s/$$$$/'*)
				bad "transform が空振りする: ${f##*/} の $(echo "$l" | sed 's/.*=[ 	]*//')"
				note "   s/\$\$\$\$/ ではなく s/\$\$/ と書く" ;;
			esac
		done ;;
	esac

	# 5. pkglint
	if [ -x "$PKGLINT" ]; then
		n=$("$PKGLINT" -Wall "$pkg" 2>&1 \
			| grep -cE '^(ERROR|WARN)' || true)
		[ "$n" = 0 ] || note "pkglint が $n 件言っている (理由を書いたものを含む)"
	fi
}

check_diff() {
	d=$1
	printf '=== %s\n' "$d"
	[ -f "$d" ] || { bad "そんな差分は無い"; return; }

	# send-pr の本文は diff を tab で字下げして貼る。下の検査はどれも行頭の
	# ^--- や ^@@ を見るので、字下げされたままだと **一つも当たらないまま
	# OK を出す**。.pr を七本通して全部 OK が出たとき、実際には何も見て
	# いなかった。行頭の ^--- が無く ^<tab>--- が在るなら、剥がした写しを見る。
	if ! grep -q '^--- ' "$d" && grep -q '^	--- ' "$d"; then
		u=$TMP/pr-ready-unindent.$$
		sed 's/^	//' "$d" > "$u"
		a=$(wc -l < "$d"); b=$(wc -l < "$u")
		if [ "$a" != "$b" ]; then
			bad "字下げを剥がしたら行数が変わった ($a -> $b)"
			rm -f "$u"
			return
		fi
		note "   (本文の字下げを剥がして見る)"
		# .pr だと分かった所で header も見る。送ってからでは直せない。
		#   Cc が From と違うと、出した物の控えが手元に残らない
		#   (PR 60589/60590/60591 がそうなった)
		#   Subject と >Synopsis: が食い違うと、gnats の一覧と件名が別物になる
		#   本文に非 ASCII が混ざると mail で化ける
		_h() { sed -n "s/^$1[[:space:]]*//p" "$d" | head -1; }
		_from=$(_h 'From:')
		[ "$(_h 'To:')" = "gnats-bugs@NetBSD.org" ] || bad "To: が gnats-bugs@NetBSD.org でない"
		[ -n "$_from" ] || bad "From: が無い"
		[ "$(_h 'Cc:')" = "$_from" ] || bad "Cc: が From: と違う (控えが残らない)"
		[ "$(_h 'Reply-To:')" = "$_from" ] || bad "Reply-To: が From: と違う"
		_subj=$(_h 'Subject:')
		_syn=$(sed -n 's/^>Synopsis:[[:space:]]*//p' "$d" | head -1)
		[ "$_subj" = "$_syn" ] || {
			bad "Subject と >Synopsis: が違う"
			echo "       Subject:  $_subj"
			echo "       Synopsis: $_syn"
		}
		[ "$(sed -n 's/^>Category:[[:space:]]*//p' "$d" | head -1)" = pkg ] \
			|| bad ">Category: が pkg でない"
		for _s in Description How-To-Repeat Fix; do
			grep -q "^>$_s:" "$d" || bad ">$_s: の節が無い"
		done
		_n=$(LC_ALL=C grep -c '[^ -~	]' "$d" || true)
		[ "${_n:-0}" = 0 ] || bad "本文に非 ASCII の行が ${_n} 行ある (mail で化ける)"
		# 本文 (diff より前) を控える。新しい file の名前がそこに
		# 書かれているかを、下の 8 番で突き合わせる。
		sed -n "1,$(( $(grep -n '^	--- ' "$d" | head -1 | cut -d: -f1) - 1 ))p" \
			"$d" > $TMP/pr-ready-body.$$
		d=$u
	fi

	# 6. 上流の Id 行を書き換えていないか。file を丸ごと消すときは Id 行も
	#    消えるので、それは数えない。同じ file の中で消えて足されたものだけ。
	awk '
		/^--- /{ f=$2; sub(/\.orig$/,"",f); del=0; add=0; next }
		/^\+\+\+ /{ next }
		/^-.*\$NetBSD: /{ del=1 }
		/^\+.*\$NetBSD/{ if (del) print f }
	' "$d" | sort -u > /tmp/pr-ready-id.$$ || true
	if [ -s /tmp/pr-ready-id.$$ ]; then
		bad "上流の Id 行を書き換えている:"
		sed 's/^/     /' /tmp/pr-ready-id.$$
		note "   fork の \$NetBSD\$ を上流の Id 行へ戻してから取り直す"
	fi
	rm -f /tmp/pr-ready-id.$$

	# 7. 中身が空になる file。patch は file を消せないので、本文に cvs rm と
	#    書いていなければ committer には伝わらない。
	#
	#    「足す行が無い」ではなく「残る行が無い」で見る。前は add==0 && del>0
	#    で拾っていたので、行を消すだけの diff が全部「空になる」と出ていた。
	#    uim の PLIST は 21 行消して 1 行も足さないが、387 行残る。
	#    unified diff の hunk 頭 @@ -a,b +c,d @@ の c,d を読む。どの hunk も
	#    +0,0 で、かつ file 全体がその hunk で覆われていれば空になる。
	awk '
		/^--- /{ if (f != "" && hunks > 0 && left == 0) print f;
			 f=$2; sub(/\.orig$/,"",f); hunks=0; left=1; next }
		/^\+\+\+ /{ next }
		/^@@ /{
			hunks++
			# +c,d の d を取る。d が 0 でなければ何か残る。
			n = $3; sub(/^\+/,"",n)
			if (n ~ /,/) { split(n, a, ","); d = a[2] } else { d = 1 }
			if (d != 0) left = 1; else if (hunks == 1) left = 0
			next
		}
		END{ if (f != "" && hunks > 0 && left == 0) print f }
	' "$d" > /tmp/pr-ready-rm.$$ || true
	if [ -s /tmp/pr-ready-rm.$$ ]; then
		note "空になる file (本文に cvs rm と書いたか):"
		sed 's/^/     /' /tmp/pr-ready-rm.$$
	fi
	rm -f /tmp/pr-ready-rm.$$

	# 8. 新しい file は cvs add が要る
	#
	#    最初の hunk が @@ -0,0 で始まるものだけが新しい file である。前は
	#    ^--- の行を全部並べていたので、当て物の対象が例外なく「新しい」と
	#    出ていた。誰も読まない黄色を出す検査は、無いのと同じである。
	# 名前は +++ 側から取る。新しい file の --- は /dev/null なので、
	# そちらを印字すると全部 /dev/null になって何の役にも立たない。
	awk '
		/^--- /{ f=$2; sub(/\.orig$/,"",f); first=1; next }
		/^\+\+\+ /{ if ($2 != "/dev/null") f=$2; next }
		/^@@ /{
			if (first && $2 ~ /^-0,0$/) print f
			first=0
		}
	' "$d" > $TMP/pr-ready-add.$$ || true
	if [ -s $TMP/pr-ready-add.$$ ]; then
		note "新しい file (本文に cvs add と書いたか):"
		sed 's/^/     /' $TMP/pr-ready-add.$$
		# .pr を見ているなら、書いたかどうかを人に訊かずに数える。
		# 当て物だけが入って新しい file の存在が伝わらないと、
		# committer の木で build が壊れる。落とすのは「名前が本文に
		# 無い」ときだけにする。cvs add という語そのものを求めていた
		# ことがあるが、committer は増えた file を見れば分かるので、
		# 報告に命令を書き写させるのは余計だった。名前が在れば足りる。
		if [ -f $TMP/pr-ready-body.$$ ]; then
			while read -r _f; do
				grep -qF "$(basename "$_f")" $TMP/pr-ready-body.$$ \
					|| bad "本文に $_f の名前が無い"
			done < $TMP/pr-ready-add.$$
		fi
	fi
	rm -f $TMP/pr-ready-add.$$

	# 9. diff に混ざった binary。macOS の tar が運ぶ AppleDouble (._patch-*) が
	#    patches/ に落ちていると、diff -urN は中身を出さずに
	#
	#	Binary files a/patches/._patch-foo and b/patches/._patch-foo differ
	#
	#    と書く。-x CVS は効くが ._* は除外されないので、そのまま本文に入る。
	#    三度踏んだ。二度目までは「当て物として拾われる」話だったが、三度目は
	#    報告そのものが汚れる形で出た。送る前に全文を読んで見つけたのであって、
	#    検査が止めたのではなかったので、ここに置く。
	if grep -q '^Binary files ' "$d"; then
		bad "diff に binary が混ざっている:"
		grep '^Binary files ' "$d" | sed 's/^/     /'
		note "   ._* なら消して diff を取り直す。送る側では"
		note "   COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata"
	fi

	# 10. hunk の頭が宣言した行数と、本文の行数が合っているか。
	#
	#     @@ -a,b +c,d @@ の b は「元の側の行数」で、本文の ' ' と '-' の
	#     合計に等しい。d は「新しい側の行数」で、' ' と '+' の合計。
	#
	#     手で書いた覚え書きを当て物の名前で置いていた、という形で二本壊れた。
	#     **建てた側では一度も踏まない。**木の中の file を直接編集して建てて
	#     いたので、壊れているのは差分だけで、建つものは建っていた。「建った」
	#     と「送るものが正しい」が別だという例。
	#
	#     壊れ方は二通りあり、片方は静かである。2026-09-16 に両方測った。
	#
	#	宣言 -6 +7 / 本文 2 行   rc=2
	#	  patch: **** unexpected end of file in patch
	#
	#	宣言 -3 / 本文 2 行      rc=0  当たってしまう
	#	  No such line 3 in input file, ignoring
	#	  one two -> one two three
	#
	#     後者が置く理由である。**rc が 0 で、当たり、警告が一行出るだけ。**
	#     rc を見る検査は素通りする。前者は勝手に止まるので要らない。
	#
	#     機械生成の diff では起きないが、手で書いた一行や、貼り直しで行が
	#     落ちた場合に起きる。読んでも気付けないのでここに置く。
	awk '
		function flush(   ) {
			if (h == "") return
			if (om != ob || nm != nb)
				printf "%s %s  宣言 -%d +%d / 本文 -%d +%d\n", f, h, ob, nb, om, nm
			h = ""
		}
		/^--- /{ flush(); f=$2; sub(/\.orig$/,"",f); next }
		/^\+\+\+ /{ next }
		/^@@ /{
			flush()
			h = $2 " " $3
			o = $2; sub(/^-/,"",o)
			n = $3; sub(/^\+/,"",n)
			if (o ~ /,/) { split(o, a, ","); ob = a[2] } else { ob = 1 }
			if (n ~ /,/) { split(n, b, ","); nb = b[2] } else { nb = 1 }
			om = 0; nm = 0
			next
		}
		h != "" {
			c = substr($0, 1, 1)
			if (c == " " || c == "")  { om++; nm++ }
			else if (c == "-")        { om++ }
			else if (c == "+")        { nm++ }
			else if (c == "\\")       { }   # \ No newline at end of file
			else                      { flush() }
		}
		END{ flush() }
	' "$d" > /tmp/pr-ready-hunk.$$ || true
	if [ -s /tmp/pr-ready-hunk.$$ ]; then
		bad "hunk の頭と本文の行数が合っていない:"
		sed 's/^/     /' /tmp/pr-ready-hunk.$$
		note "   当てると unexpected end of file になる。手で直さず"
		note "   素の木から diff -u で取り直す"
	fi
	rm -f /tmp/pr-ready-hunk.$$

	# 10. doc/pkg-vulnerabilities の扱い。
	#
	#     足す行が在るなら hunk を付け、本文でその行を説明する。NVD に在って
	#     木の一覧に無い CVE は実際にある。editors/xwpe は木が 1.5.30a の
	#     まま CVE-2016-20037 が NVD に在り、doc/pkg-vulnerabilities には
	#     xwpe の行が一つも無かった。取り下げられた CVE でも # で無効化して
	#     入れる (木にその形が 157 件在る)。
	#
	#     足す行が無いなら、本文に書かない。「vulnerabilities の記載には何も
	#     要らない」「pmatch で確かめた」と書いていた時期があるが、報告は
	#     当て物の話であって、調べた過程の話ではない。hunk が無いのに本文が
	#     vulnerabilities に触れていたら落とす。
	#
	#     版が動くのに hunk が無いときは、NVD と突き合わせたかを思い出させる
	#     (落とさない。突き合わせた結果が「無し」なら、それで正しい)。
	if [ -s "$TMP/pr-ready-body.$$" ]; then
		_body=$TMP/pr-ready-body.$$
		if grep -q '^--- doc/pkg-vulnerabilities' "$d"; then
			note "   doc/pkg-vulnerabilities の hunk が在る"
		elif grep -qi 'vulnerabilit' "$_body"; then
			bad "doc/pkg-vulnerabilities の hunk が無いのに、本文が vulnerabilities に触れている"
			grep -ni 'vulnerabilit' "$_body" | sed 's/^/     /'
			note "   足す行が無いなら書かない"
		elif grep -qE '^\+(DISTNAME|PKGREVISION)=' "$d"; then
			note "   版が動く。NVD をその package の CPE で引き、"
			note "   doc/pkg-vulnerabilities と突き合わせたか。足す行が在れば hunk を付ける"
		fi
		rm -f "$TMP/pr-ready-body.$$"
	fi

	# 11. 送る直前に、測った木がまだ現在かを見る。
	#
	#     本文は「Diff against pkgsrc-current of <日付> (Makefile 1.64)」
	#     の形で、いつの木に当てた物かを言う。木は日々動くので、その日付が
	#     古いまま出すと、committer が当てる木と食い違う。実際に三日前の
	#     日付のまま送る一歩手前まで行った。
	#
	#     日付だけでは足りないので、diff の文脈に残っている $NetBSD の
	#     版を上流の現在と突き合わせる。当て物の文脈に Id 行が入って
	#     いれば、木が動いた瞬間にここで落ちる。
	#
	#     網が使えない所でも走らせたいので、引けなかったときは落とさず
	#     note にする。落ちるのは「引けて、違った」ときだけ。
	if [ -s "$TMP/pr-ready-body.$$2" ]; then :; fi
	_today=$(date +%Y-%m-%d)
	_bd=$(sed -n 's/.*pkgsrc-current[^0-9]*\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\).*/\1/p' "$d" | head -1)
	if [ -n "$_bd" ] && [ "$_bd" != "$_today" ]; then
		bad "本文の日付が $_bd で今日 ($_today) ではない"
		note "   今日の木で当て直してから出す。pr-vs-built --applies も"
	fi
	if [ "${PR_READY_OFFLINE:-}" = 1 ]; then
		note "   (PR_READY_OFFLINE=1 なので木の版は引かない)"
	else
		# 版は awk で切る。sed の後段に任せると、当たらなかったときに
		# 行全体がそのまま「版」として残り、1.19 と 1.19 を比べて
		# 違うと言う。ここで一度それを出した。
		awk '
			/^--- /{ f=$2; sub(/\.orig$/,"",f); next }
			f != "" && /^ .*\$NetBSD: /{
				for (i = 1; i <= NF; i++)
					if ($i ~ /,v$/ && i < NF) { print f, $(i+1); break }
				f = ""
			}
		' "$d" > $TMP/pr-ready-rev.$$ || true
		while read -r _p _v; do
			[ -n "${_v:-}" ] || continue
			_up=$(curl -sf --max-time 20 \
				"https://raw.githubusercontent.com/NetBSD/pkgsrc/trunk/$_p" |
				sed -n 's/.*\$NetBSD: [^,]*,v \([^ ]*\) .*/\1/p' | head -1)
			if [ -z "$_up" ]; then
				note "   $_p の版を上流から引けなかった"
			elif [ "$_up" != "$_v" ]; then
				bad "$_p が木で動いた ($_v -> $_up)"
				note "   その木で測り直してから出す"
			fi
		done < $TMP/pr-ready-rev.$$
		rm -f $TMP/pr-ready-rev.$$

		# 12. 版を上げる報告なら、上げた先が上流の最新かを見る。
		#     tag の間隔が数日の上流も在るので、書いてから送るまでの
		#     数日で追い越されることがある。
		#
		#     上流の在処は package の MASTER_SITES から引く。GitHub と
		#     Codeberg だけを見て、それ以外は手で確かめろと言うに留める。
		#     ここで分かるのは「最新か」だけで、上げるべきかは別の判断。
		_dn=$(sed -n 's/^+DISTNAME=[[:space:]]*//p' "$d" | head -1)
		if [ -n "$_dn" ]; then
			_pkgdir=$(sed -n 's/^--- \(.*\)\/Makefile\.orig$/\1/p' "$d" | head -1)
			# 上流の在処は diff の + 側を先に見る。版を上げる報告では
			# MASTER_SITES ごと動くことがあり (xwpe は
			# identicalsoftware.com から codeberg へ移った)、木の
			# Makefile を見ると古い在処を引いて空を返す。
			_mk=$(sed -n 's/^+//p' "$d" | grep MASTER_SITE || true)
			[ -n "$_mk" ] || _mk=$(curl -sf --max-time 20 \
			    "https://raw.githubusercontent.com/NetBSD/pkgsrc/trunk/$_pkgdir/Makefile" || true)
			_ver=${_dn##*-}
			_owner=$(printf '%s\n' "$_mk" | sed -n 's/.*MASTER_SITE_GITHUB:=\([^}/]*\).*/\1/p' | head -1)
			_cb=$(printf '%s\n' "$_mk" | sed -n 's/.*MASTER_SITE_CODEBERG:=\([^}/]*\/[^}/]*\).*/\1/p' | head -1)
			_pkgbase=$(printf '%s\n' "$_dn" | sed 's/-[^-]*$//')
			_latest=
			if [ -n "$_owner" ]; then
				_latest=$(curl -sf --max-time 20 \
				    "https://api.github.com/repos/$_owner/$_pkgbase/releases/latest" |
				    sed -n 's/.*"tag_name"[^"]*"\([^"]*\)".*/\1/p' | head -1)
			elif [ -n "$_cb" ]; then
				_latest=$(curl -sf --max-time 20 \
				    "https://codeberg.org/api/v1/repos/$_cb/releases/latest" |
				    sed -n 's/.*"tag_name"[^"]*"\([^"]*\)".*/\1/p' | head -1)
			fi
			if [ -z "$_latest" ]; then
				note "   上流の最新は引けなかった。$_ver が最新か手で確かめる"
			elif [ "${_latest#v}" != "$_ver" ]; then
				bad "上流は ${_latest#v} で、この diff は $_ver"
				note "   出す版を決め直してから送る"
			else
				note "   上流の最新と同じ版 ($_ver)"
			fi
		fi
	fi
}

for d in "$@"; do
	case $d in
	--diff) mode=diff ;;
	*) if [ "${mode:-pkg}" = diff ]; then check_diff "$d"; mode=pkg
	   else check_one "$d"; fi ;;
	esac
done

if [ "$fail" = 0 ]; then
	echo "OK: 静的に見える範囲では足りている。建てたかどうかは別に確かめること。"
else
	echo "NG: このまま send-pr へ出さない。"
	exit 1
fi
