#!/bin/sh
#
# 送る .pr と、CI が実際に建てた物が同じかを見る。
#
#	pr-vs-built --diff <.pr> <tree 当て物>	触る file の集合を比べる
#	pr-vs-built --fork <.pr> <fork dir> <上流の pkgdir>
#						上流の package に .pr を当てて
#						fork と中身ごと比べる
#	pr-vs-built --applies <.pr>		今日の pkgsrc trunk にまだ
#						当たるかを fuzz 無しで見る
#
# pr-ready は「その diff が静的に足りているか」を見る。こちらは別の問い
# ——「測ったものと送るものは同じ物か」——を見る。二つは同じではない。
#
# 実際に外していた。zlib の .pr は doc/pkg-vulnerabilities を触るのに、
# CI が当てる tree 当て物は三 file しか持っておらず、その行は一度も
# 踏まれないまま送られる所だった。build が踏まない file は、測った顔を
# して測られていない。
#
# fork を建てている package (croc、xwpe) では file の集合だけでは足りない。
# 集合が合っていても中身が違えば、建てた物と送る物は別である。上流の
# package を取ってきて .pr を当て、fork と diff -r で比べるところまでやる。
set -eu
LC_ALL=C; export LC_ALL
T=${TMPDIR:-/tmp}
rc=0
bad() { echo "  !! $*"; rc=1; }

# .pr の本文は diff を tab で字下げして貼る。剥がしてから読む。
pr_diff() {
	n=$(grep -n '^	--- ' "$1" | head -1 | cut -d: -f1) || true
	[ -n "${n:-}" ] || { echo "  !! .pr に字下げされた diff が無い" >&2; return 1; }
	sed -n "${n},\$p" "$1" | sed 's/^	//'
}
files_of() { awk '/^\+\+\+ /{print $2}' | sort -u; }

usage() { sed -n '3,14p' "$0"; exit 2; }
[ $# -ge 2 ] || usage
mode=$1; pr=$2; shift 2
[ -f "$pr" ] || { echo "そんな .pr は無い: $pr" >&2; exit 2; }

case "$mode" in
--diff)
	d=$1
	[ -f "$d" ] || { echo "そんな当て物は無い: $d" >&2; exit 2; }
	pr_diff "$pr" | files_of > "$T/pvb.pr.$$"
	files_of < "$d" > "$T/pvb.ci.$$"
	a=$(comm -23 "$T/pvb.pr.$$" "$T/pvb.ci.$$")
	b=$(comm -13 "$T/pvb.pr.$$" "$T/pvb.ci.$$")
	[ -n "$a" ] && { bad "送るが CI が当てない:"; echo "$a" | sed 's/^/       /'; }
	[ -n "$b" ] && { bad "CI が当てるが送らない:"; echo "$b" | sed 's/^/       /'; }
	[ $rc -eq 0 ] && echo "  ok 同じ $(wc -l < "$T/pvb.pr.$$" | tr -d ' ') file"
	rm -f "$T/pvb.pr.$$" "$T/pvb.ci.$$"
	;;
--fork)
	fork=$1; pkgdir=$2
	[ -d "$fork" ] || { echo "そんな fork は無い: $fork" >&2; exit 2; }
	w=$T/pvb.$$; rm -rf "$w"; mkdir -p "$w/$pkgdir"
	echo "  上流の $pkgdir を取る"
	for f in $(gh api "repos/NetBSD/pkgsrc/contents/$pkgdir" \
	    --jq '.[]|select(.type=="file")|.name' < /dev/null 2>/dev/null); do
		gh api "repos/NetBSD/pkgsrc/contents/$pkgdir/$f" --jq '.content' \
		    < /dev/null 2>/dev/null | base64 -d > "$w/$pkgdir/$f"
	done
	for sub in patches files; do
		gh api "repos/NetBSD/pkgsrc/contents/$pkgdir/$sub" --jq '.[].name' \
		    < /dev/null > "$T/pvb.sub.$$" 2>/dev/null || continue
		mkdir -p "$w/$pkgdir/$sub"
		while read -r f; do
			gh api "repos/NetBSD/pkgsrc/contents/$pkgdir/$sub/$f" --jq '.content' \
			    < /dev/null 2>/dev/null | base64 -d > "$w/$pkgdir/$sub/$f"
		done < "$T/pvb.sub.$$"
		rm -f "$T/pvb.sub.$$"
	done
	n=$(find "$w" -type f | wc -l | tr -d ' ')
	[ "$n" -gt 0 ] || { bad "上流から一つも取れなかった"; exit 1; }
	echo "  取った: $n file"

	pr_diff "$pr" > "$T/pvb.diff.$$"
	( cd "$w" && patch -C -f -p0 -i "$T/pvb.diff.$$" < /dev/null > /dev/null 2>&1 ) \
		|| { bad "空当てが通らない"; rm -rf "$w"; exit 1; }
	( cd "$w" && patch -f -p0 -i "$T/pvb.diff.$$" < /dev/null > /dev/null 2>&1 ) \
		|| { bad "本当てが落ちた"; rm -rf "$w"; exit 1; }
	find "$w" -name '*.orig' -delete

	# patch は file を消せないので、消える file は本文に名前で書くしかない。
	# 以前は本文の「cvs rm:」の行を読んで消していたが、その書き方を
	# やめたとき、消える八本の名前が本文から丸ごと落ちたのに検査は
	# 通った (下の diff -r が Only in を数えていなかったのと二重の穴)。
	#
	# 言い回しに頼らず、上流に在って fork に無い file を列挙し、その
	# 名前が本文に在るかを見る。在れば消えたものとして扱う。無ければ
	# committer に伝わらないので落とす。
	_body=$T/pvb.body.$$
	sed -n "1,$(( $(grep -n '^	--- ' "$pr" | head -1 | cut -d: -f1) - 1 ))p" "$pr" > "$_body"
	( cd "$w/$pkgdir" && find . -type f | sed 's|^\./||' ) | sort > "$T/pvb.up.$$"
	( cd "$fork" && find . -type f | sed 's|^\./||' ) | sort > "$T/pvb.fk.$$"
	comm -23 "$T/pvb.up.$$" "$T/pvb.fk.$$" | while read -r f; do
		case $f in CVS/*|*/CVS/*) continue ;; esac
		if grep -qF "${f##*/}" "$_body"; then
			rm -f "$w/$pkgdir/$f"
		else
			echo "BAD $f"
		fi
	done > "$T/pvb.gone.$$"
	if [ -s "$T/pvb.gone.$$" ]; then
		sed 's/^BAD /  !! 消える file の名前が本文に無い: /' "$T/pvb.gone.$$"
		rc=1
	fi
	rmdir "$w/$pkgdir/files" 2>/dev/null || true
	rm -f "$_body" "$T/pvb.up.$$" "$T/pvb.fk.$$" "$T/pvb.gone.$$"

	echo "  === fork との差 (\$NetBSD\$ の Id 行だけなら同じ物) ==="
	if diff -r --exclude=CVS "$w/$pkgdir" "$fork" > "$T/pvb.out.$$" 2>&1; then
		echo "  ok 完全に同一"
	else
		# Id 行だけの差かどうかを数える。片方にだけ在る file は
		# 「Only in」の行になり < > を持たないので、別に数えないと
		# 見えない。消えるはずの file が残っていても通していた。
		_only=$(grep -c '^Only in ' "$T/pvb.out.$$" || true)
		o=$(grep -c '^[<>]' "$T/pvb.out.$$" || true)
		i=$(grep -c '^[<>].*\$NetBSD' "$T/pvb.out.$$" || true)
		if [ "${_only:-0}" != 0 ]; then
			bad "片方にだけ在る file が ${_only} 件"
			grep '^Only in ' "$T/pvb.out.$$" | sed 's/^/     /'
		elif [ "$o" = "$i" ] && [ "$o" != 0 ]; then
			echo "  ok 差は \$NetBSD\$ の Id 行 $((o / 2)) 本だけ"
		else
			bad "Id 行以外の差がある ($o 行のうち Id 行は $i 行)"
			sed 's/^/     /' "$T/pvb.out.$$" | head -40
		fi
	fi
	rm -rf "$w" "$T/pvb.diff.$$" "$T/pvb.out.$$"
	;;
--applies)
	# 触る file だけを raw から引いて、その場で空当てする。
	#
	# -F0 が要る。patch -C は既定で fuzz を許すので、木が動いて文脈行が
	# 変わっていても黙って通る。文脈を一行だけ壊した .pr を通したら
	# 「当たる」と出た。-C だけでは「まだ当たる」を測れない。
	w=$T/pvb.ap.$$; rm -rf "$w"; mkdir -p "$w"
	pr_diff "$pr" > "$T/pvb.apd.$$"
	got=0
	for t in $(files_of < "$T/pvb.apd.$$"); do
		case "$t" in /dev/null) continue;; esac
		mkdir -p "$w/$(dirname "$t")"
		curl -sfL "https://raw.githubusercontent.com/NetBSD/pkgsrc/trunk/$t" \
			-o "$w/$t" && got=$((got+1))
	done
	out=$( cd "$w" && patch -C -f -F0 -p0 -i "$T/pvb.apd.$$" < /dev/null 2>&1 ) || {
		bad "今日の pkgsrc trunk に当たらない"
		echo "$out" | sed 's/^/     /' | head -8
	}
	[ $rc -eq 0 ] && echo "  ok 当たる (上流から $got file を引いた、fuzz 無し)"
	rm -rf "$w" "$T/pvb.apd.$$"
	;;
*) usage ;;
esac
exit $rc
