#!/bin/sh
#
# zakinko/home の .sbin から、この repo が使う写しを取り直す。
#
#	bin/nb-sync-sbin [home の作業ツリー]
#	git diff sbin/
#
# 正は zakinko/home の .sbin。以前は techne の ~/.sbin を ssh で読んでいた。
# あれは .sbin が CVS (elena.sh.fml.org:/cvsroot) にしか無く、GitHub Actions
# からその CVS に届かなかったからで、写しがこの repo にある理由もそれだった。
# .sbin が git に移った時点でその前提は消えたので、取得元を git にしてある。
#
# 写しをやめて CI から zakinko/home を直接引く手もあるが、private なので
# Actions に token を持たせることになる。写しなら CI は何も持たなくてよく、
# 何を作ったかが commit として残るので、写しは残す。
# **写しを直接編集しないこと。** 直すのは zakinko/home の側。
#
# mk.conf も zakinko/home の etc/mk.conf から取る。以前は techne の /etc/mk.conf
# を ssh で写していたが、あれは ~/etc/mk.conf が配られた結果であって正では
# なく、配り忘れがそのまま CI に写った (PREFER_PKGSRC+=openssl が抜けて
# apache が base の OpenSSL 3.0 で建ち、MLKEM の group が出なくなった)。
# ~/etc が追跡されるようになったので、正から直接取れる。ssh は要らない。
#
# zakinko/home の作業ツリーは $HOME そのもの (bare は ~/.home.git)。以前の
# ~/git/home の clone は消えている。

set -eu

HOME_TREE=${1:-$HOME}
if [ -d "$HOME_TREE/.home.git" ]; then
	HG="git --git-dir=$HOME_TREE/.home.git --work-tree=$HOME_TREE"
else
	HG="git -C $HOME_TREE"
fi

[ -d "$HOME_TREE/.sbin" ] || { echo "$0: $HOME_TREE/.sbin が無い"; exit 1; }

# 作業ツリーの途中の状態を写すと、CI が「まだ誰も見ていないもの」を作る。
# origin に出ているものだけを正とする。
echo "=== $HOME_TREE を確かめる"
$HG fetch -q origin
if [ -n "$($HG status --porcelain -- .sbin etc/mk.conf)" ]; then
	echo "$0: .sbin か etc/mk.conf に未コミットの変更がある。先に commit すること"
	$HG status --short -- .sbin etc/mk.conf
	exit 1
fi
if [ -n "$($HG rev-list origin/main..HEAD -- .sbin etc/mk.conf)" ]; then
	echo "$0: .sbin か etc/mk.conf に push していない commit がある。先に push すること"
	exit 1
fi
REF=$($HG rev-parse --short origin/main)

cd "$(dirname "$0")/.."
mkdir -p sbin

echo "=== zakinko/home $REF の .sbin から取る"

# origin/main の中身をそのまま出す。作業ツリーの状態には依らない。
for f in $($HG ls-tree --name-only "origin/main:.sbin" \
           | grep -E '^(list\.pkg\.|Makefile$)'); do
	$HG show "origin/main:.sbin/$f" >"sbin/$f"
	echo "    $f"
done

echo "=== zakinko/home $REF の etc/mk.conf から取る"
$HG show "origin/main:etc/mk.conf" >sbin/mk.conf
echo "    mk.conf (etc/mk.conf)"

{
	echo "# bin/nb-sync-sbin が書く。手で触らない。"
	echo "#"
	echo "# 正     : zakinko/home の .sbin"
	echo "# commit : $REF"
	echo "# mk.conf: zakinko/home の etc/mk.conf"
	echo "# 取得   : $(date '+%Y-%m-%d %H:%M:%S %z')"
	echo
	for f in sbin/*; do
		case "$f" in sbin/SOURCE) continue ;; esac
		id=$(LC_ALL=C sed -n 's/.*\$\(FML: [^$]*\)\$.*/\1/p' "$f" | head -1)
		printf '%-24s %s\n' "${f##*/}" "${id:-(版の記載なし)}"
	done
} >sbin/SOURCE

echo
echo "=== 取れたもの"
cat sbin/SOURCE
