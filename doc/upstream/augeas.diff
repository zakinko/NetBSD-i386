diff -u /dev/null sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
--- /dev/null
+++ sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
@@ -0,0 +1,42 @@
+$NetBSD$
+
+Test that the perl form of adduser.conf is read; see
