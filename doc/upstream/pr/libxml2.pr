	+DISTNAME=	libxml2-2.15.3
	 CATEGORIES=	textproc
	 MASTER_SITES=	${MASTER_SITE_GNOME:=sources/libxml2/${PKGVERSION_NOREV:R}/}
	 EXTRACT_SUFX=	.tar.xz
