tIndex: sysutils/augeas/patches/patch-CVE-2025-2588
t===================================================================
tRCS file: sysutils/augeas/patches/patch-CVE-2025-2588
tdiff -u /dev/null sysutils/augeas/patches/patch-CVE-2025-2588
t--- /dev/null
t+++ sysutils/augeas/patches/patch-CVE-2025-2588
t@@ -0,0 +1,68 @@
t+$NetBSD$
t+
t+Fix a NULL dereference in the regexp parser.  CVE-2025-2588.
t+
t+parse_regexp() could return NULL while leaving parse->error at REG_NOERROR.
t+fa_expand_nocase(), fa_restrict_alphabet() and fa_expand_char_ranges() only
t+test parse->error before dereferencing what came back, so they walk into the
t+NULL and the process dies.  Upstream fixed this at the error label rather
t+than adding a check to each of the three callers.
t+
t+Upstream commit af2aa88ab37fc48167d8c5e43b1770a4ba2ff403 applied verbatim:
t+the fix itself, the fa.h comment that documents the new return value, and
t+the regression test.  It has not been released; 1.14.1 (2023) is still the
t+last release.
t+
t+_REG_ENOSYS is not in NetBSD's <regex.h>, but augeas is built with
t+-I ../gnulib/lib and takes <regex.h> from the bundled gnulib copy, which
t+defines it.  Without the src/fa.c hunk below, tests/fatest dies with SIGSEGV.
t+
t+https://github.com/hercules-team/augeas/issues/852
t+
t+--- src/fa.c.orig
t++++ src/fa.c
t+@@ -3550,6 +3550,8 @@
t+     return re;
t+ 
t+  error:
t++    if (re == NULL && parse->error == REG_NOERROR)
t++        parse->error = _REG_ENOSYS;
t+     re_unref(re);
t+     return NULL;
t+ }
t+
t+--- src/fa.h.orig
t++++ src/fa.h
t+@@ -81,7 +81,8 @@
t+  *
t+  * On success, FA points to the newly allocated automaton constructed for
t+  * RE, and the function returns REG_NOERROR. Otherwise, FA is NULL, and the
t+- * return value indicates the error.
t++ * return value indicates the error. Special value _REG_ENOSYS indicates
t++ * fa_compile() couldn't identify the syntax issue with regexp.
t+  *
t+  * The FA is case sensitive. Call FA_NOCASE to switch it to
t+  * case-insensitive.
t+
t+--- tests/fatest.c.orig
t++++ tests/fatest.c
t+@@ -589,6 +589,7 @@
t+     const char *p1 = "aB";
t+     const char *p2 = "[a-cUV]";
t+     const char *p3 = "[^a-z]";
t++    const char *wrong_regexp = "{&.{";
t+     char *s;
t+     size_t len;
t+     int r;
t+@@ -607,6 +608,11 @@
t+     CuAssertIntEquals(tc, 0, r);
t+     CuAssertStrEquals(tc, "[^A-Za-z]", s);
t+     free(s);
t++
t++    /* Test that fa_expand_nocase does return _REG_ENOSYS */
t++    r = fa_expand_nocase(wrong_regexp, strlen(wrong_regexp), &s, &len);
t++    CuAssertIntEquals(tc, _REG_ENOSYS, r);
t++    free(s);
t+ }
t+ 
t+ static void testNoCaseComplement(CuTest *tc) {
tIndex: sysutils/augeas/patches/patch-Makefile.in
t===================================================================
tRCS file: sysutils/augeas/patches/patch-Makefile.in
tdiff -u /dev/null sysutils/augeas/patches/patch-Makefile.in
t--- /dev/null
t+++ sysutils/augeas/patches/patch-Makefile.in
t@@ -0,0 +1,26 @@
t+$NetBSD$
t+
t+Install the lenses.  They depend on GNU make otherwise.
t+
t+Makefile.am picks the lens lists up with $(wildcard), which is a GNU make
t+function.  bmake leaves it as the literal string, both lists come out empty
t+and no lens is installed at all, so augtool cannot read any configuration
t+file.  The package has been shipping that way since 2014.
t+
t+The lists are globbed in configure instead; see patch-configure.  Sent
t+upstream as well.  Patching the generated files rather than Makefile.am and
t+configure.ac keeps autoreconf out of the build here.
t+
t+--- Makefile.in.orig
t++++ Makefile.in
t+@@ -1703,8 +1703,8 @@
t+ ACLOCAL_AMFLAGS = -I gnulib/m4
t+ lensdir = $(datadir)/augeas/lenses/dist
t+ lenstestdir = $(datadir)/augeas/lenses/dist/tests
t+-dist_lens_DATA = $(wildcard lenses/*.aug)
t+-dist_lenstest_DATA = $(wildcard lenses/tests/*.aug)
t++dist_lens_DATA = @LENS_FILES@
t++dist_lenstest_DATA = @LENS_TEST_FILES@
t+ EXTRA_DIST = augeas.spec build/ac-aux/move-if-change Makefile.am HACKING.md
t+ pkgconfigdir = $(libdir)/pkgconfig
t+ pkgconfig_DATA = augeas.pc
tIndex: sysutils/augeas/patches/patch-configure
t===================================================================
tRCS file: sysutils/augeas/patches/patch-configure
tdiff -u /dev/null sysutils/augeas/patches/patch-configure
t--- /dev/null
t+++ sysutils/augeas/patches/patch-configure
t@@ -0,0 +1,82 @@
t+$NetBSD$
t+
t+Two changes to the generated script.
t+
t+Glob the lens lists here rather than with $(wildcard) in the makefile; see
t+patch-Makefile.in.  Doing it in configure rather than leaving a bare glob
t+in the makefile is what makes an out-of-tree build work: the install rule
t+falls back to $(srcdir)/ only when it can test each name, which it cannot
t+do with a pattern.  Sent upstream as hercules-team/augeas#889.
t+
t+Do not use -fexceptions where the personality routine cannot be linked.
t+The flag makes the compiler emit exception tables, and those name
t+__gcc_personality_v0.  The check upstream makes is a compile and link of a
t+program whose main() is empty, which settles nothing: an empty main() has
t+no exception table and so never mentions the routine, the flag is
t+accepted, and the link of the real program fails afterwards.  On OpenBSD
t+that is what happens; libcompiler_rt.a has the routine but _Unwind_* live
t+only in libc++abi, which a C program does not link:
t+
t+  ld: error: undefined symbol: _Unwind_GetLanguageSpecificData
t+  >>> referenced by gcc_personality_v0.c:203
t+  >>>   gcc_personality_v0.o:(__gcc_personality_v0)
t+  >>>   in archive /usr/lib/libcompiler_rt.a
t+
t+Asking for the routine itself changes nothing where it links, so NetBSD
t+and Linux are unaffected.  Sent upstream as hercules-team/augeas#891,
t+which changes acinclude.m4; this is the same check written the way the
t+generated script does it, so that autoreconf is not needed here.
t+
t+--- configure.orig
t++++ configure
t+@@ -2153,6 +2153,8 @@
t+ PACKAGE_NAME
t+ PATH_SEPARATOR
t+ SHELL
t++LENS_FILES
t++LENS_TEST_FILES
t+ am__quote'
t+ ac_subst_files=''
t+ ac_user_opts='
t+@@ -17842,6 +17844,31 @@
t+     warnCFLAGS=
t+ 
t+     common_flags="-fexceptions -fasynchronous-unwind-tables"
t++
t++    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether __gcc_personality_v0 can be linked" >&5
t++printf %s "checking whether __gcc_personality_v0 can be linked... " >&6; }
t++cat confdefs.h - <<_ACEOF >conftest.$ac_ext
t++/* end confdefs.h.  */
t++extern void __gcc_personality_v0(void);
t++int
t++main (void)
t++{
t++__gcc_personality_v0();
t++  ;
t++  return 0;
t++}
t++_ACEOF
t++if ac_fn_c_try_link "$LINENO"
t++then :
t++  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
t++printf "%s\n" "yes" >&6; }
t++else $as_nop
t++  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
t++printf "%s\n" "no" >&6; }
t++    common_flags=""
t++fi
t++rm -f core conftest.err conftest.$ac_objext conftest.beam \
t++    conftest$ac_exeext conftest.$ac_ext
t+ 
t+     case "$enable_compile_warnings" in
t+     no)
t+@@ -52016,6 +52043,9 @@
t+ fi
t+ 
t+ 
t++LENS_FILES=`cd "$srcdir" && echo lenses/*.aug`
t++LENS_TEST_FILES=`cd "$srcdir" && echo lenses/tests/*.aug`
t++
t+ ac_config_files="$ac_config_files Makefile gnulib/lib/Makefile gnulib/tests/Makefile src/Makefile man/Makefile tests/Makefile examples/Makefile doc/Makefile doc/naturaldocs/Makefile augeas.pc augeas.spec"
t+ 
t+ cat >confcache <<\_ACEOF
tIndex: sysutils/augeas/patches/patch-examples_dump.c
t===================================================================
tRCS file: sysutils/augeas/patches/patch-examples_dump.c
tdiff -u /dev/null sysutils/augeas/patches/patch-examples_dump.c
t--- /dev/null
t+++ sysutils/augeas/patches/patch-examples_dump.c
t@@ -0,0 +1,16 @@
t+$NetBSD$
t+
t+Print elapsed time with a format that matches time_t.  See
t+patch-src_augtool.c.
t+
t+--- examples/dump.c.orig
t++++ examples/dump.c
t+@@ -119,7 +119,7 @@
t+                              const struct timeval *stop) {
t+     time_t elapsed = (stop->tv_sec - start->tv_sec)*1000
t+                    + (stop->tv_usec - start->tv_usec)/1000;
t+-    fprintf(stderr, "time: %ld ms\n", elapsed);
t++    fprintf(stderr, "time: %lld ms\n", (long long) elapsed);
t+ }
t+ 
t+ int main(int argc, char **argv) {
tIndex: sysutils/augeas/patches/patch-lenses_pg_hba.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_pg_hba.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_pg_hba.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_pg_hba.aug
t@@ -0,0 +1,20 @@
t+$NetBSD$
t+
t+Add the /usr/local paths, which are missing from three filters.
t+
t+/usr/local/pgsql/data is what PostgreSQL itself uses by default, on any
t+operating system, when built from source with the default prefix.  The
t+filter carries the Red Hat and Debian layouts but not that one.
t+
t+Sent upstream as hercules-team/augeas#888; this is that diff.
t+
t+--- lenses/pg_hba.aug.orig
t++++ lenses/pg_hba.aug
t+@@ -81,6 +81,7 @@ module Pg_Hba =
t+     (* View: filter
t+         The pg_hba.conf conf file *)
t+     let filter = (incl "/var/lib/pgsql/data/pg_hba.conf" .
t++                  incl "/usr/local/pgsql/data/pg_hba.conf" .
t+                   incl "/var/lib/pgsql/*/data/pg_hba.conf" .
t+                   incl "/var/lib/postgresql/*/data/pg_hba.conf" .
t+                   incl "/etc/postgresql/*/*/pg_hba.conf" )
tIndex: sysutils/augeas/patches/patch-lenses_postgresql.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_postgresql.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_postgresql.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_postgresql.aug
t@@ -0,0 +1,20 @@
t+$NetBSD$
t+
t+Add the /usr/local paths, which are missing from three filters.
t+
t+/usr/local/pgsql/data is what PostgreSQL itself uses by default, on any
t+operating system, when built from source with the default prefix.  The
t+filter carries the Red Hat and Debian layouts but not that one.
t+
t+Sent upstream as hercules-team/augeas#888; this is that diff.
t+
t+--- lenses/postgresql.aug.orig
t++++ lenses/postgresql.aug
t+@@ -70,6 +70,7 @@ let lns = (Util.empty | Util.comment | entry)*
t+ 
t+ (* Variable: filter *)
t+ let filter = (incl "/var/lib/pgsql/data/postgresql.conf" .
t++              incl "/usr/local/pgsql/data/postgresql.conf" .
t+               incl "/var/lib/pgsql/*/data/postgresql.conf" .
t+               incl "/var/lib/postgresql/*/data/postgresql.conf" .
t+               incl "/etc/postgresql/*/*/postgresql.conf" )
tIndex: sysutils/augeas/patches/patch-lenses_rsyslog.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_rsyslog.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_rsyslog.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_rsyslog.aug
t@@ -0,0 +1,22 @@
t+$NetBSD$
t+
t+Add the /usr/local paths, which are missing from three filters.
t+
t+On the BSDs rsyslog is configured under /usr/local/etc, as software the
t+system did not ship itself.  Dovecot, Nginx, Php, Postfix, Puppet,
t+Sudoers and Systemd already carry their /usr/local counterpart; Rsyslog
t+does not.
t+
t+Sent upstream as hercules-team/augeas#888; this is that diff.
t+
t+--- lenses/rsyslog.aug.orig
t++++ lenses/rsyslog.aug
t+@@ -93,6 +93,8 @@ let lns = entries . ( program | hostname )*
t+ 
t+ let filter = incl "/etc/rsyslog.conf"
t+            . incl "/etc/rsyslog.d/*"
t++           . incl "/usr/local/etc/rsyslog.conf"
t++           . incl "/usr/local/etc/rsyslog.d/*"
t+            . Util.stdexcl
t+ 
t+ let xfm = transform lns filter
tIndex: sysutils/augeas/patches/patch-lenses_shellvars.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_shellvars.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_shellvars.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_shellvars.aug
t@@ -0,0 +1,25 @@
t+$NetBSD$
t+
t+Do not read /etc/adduser.conf as a shell script.
t+
t+Of the three systems that ship the file, only FreeBSD treats it as one.
t+OpenBSD's adduser(8) is perl and evals each line, so what it writes is
t+perl and this lens fails on it outright.  Debian's is perl too and allows
t+whitespace around the equals sign, which this lens does not reject but
t+reads as a command, so the setting disappears without an error.  NetBSD
t+has no adduser(8); useradd(8) reads /etc/usermgmt.conf instead.
t+
t+Simplevars accepts all three; see patch-lenses_simplevars.aug.
t+
t+Sent upstream as hercules-team/augeas#893; this is that diff.
t+
t+--- lenses/shellvars.aug.orig
t++++ lenses/shellvars.aug
t+@@ -305,7 +305,6 @@
t+                      . incl "/etc/environment"
t+                      . incl "/etc/firewalld/firewalld.conf"
t+                      . incl "/etc/blkid.conf"
t+-                     . incl "/etc/adduser.conf"
t+                      . incl "/etc/cowpoke.conf"
t+                      . incl "/etc/cvs-cron.conf"
t+                      . incl "/etc/cvs-pserver.conf"
tIndex: sysutils/augeas/patches/patch-lenses_simplevars.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_simplevars.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_simplevars.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_simplevars.aug
t@@ -0,0 +1,29 @@
t+$NetBSD$
t+
t+Two entries in this filter.
t+
t+Take over /etc/adduser.conf from Shellvars, which cannot read what
t+OpenBSD's adduser(8) writes and silently mis-reads Debian's; see
t+patch-lenses_shellvars.aug.  Sent upstream as hercules-team/augeas#893.
t+
t+Fix the path of OpenBSD's wsconsctl.conf.  The entry has read
t+/etc/wsconsctlctl.conf since it was added upstream in aa3bc264 (2013), so
t+it has never matched anything.  What OpenBSD's /etc/rc applies is
t+/etc/wsconsctl.conf, one wsconsctl(8) variable assignment per line, which
t+this lens parses as it stands.  NetBSD is unaffected: it has
t+/etc/wscons.conf, a different file in a different format.  Sent upstream
t+as hercules-team/augeas#887.
t+
t+--- lenses/simplevars.aug.orig
t++++ lenses/simplevars.aug
t+@@ -44,8 +44,9 @@
t+            . incl "/etc/wgetrc"
t+            . incl "/etc/zabbix/*.conf"
t+            . incl "/etc/audit/auditd.conf"
t++           . incl "/etc/adduser.conf"
t+            . incl "/etc/mixerctl.conf"
t+-           . incl "/etc/wsconsctlctl.conf"
t++           . incl "/etc/wsconsctl.conf"
t+            . incl "/etc/ocsinventory/ocsinventory-agent.cfg"
t+ 
t+ let xfm = transform lns filter
tIndex: sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
t===================================================================
tRCS file: sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
tdiff -u /dev/null sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
t--- /dev/null
t+++ sysutils/augeas/patches/patch-lenses_tests_test_simplevars.aug
t@@ -0,0 +1,42 @@
t+$NetBSD$
t+
t+Test that the perl form of adduser.conf is read; see
t+patch-lenses_simplevars.aug.
t+
t+Sent upstream as hercules-team/augeas#893; this is that diff.
t+
t+--- lenses/tests/test_simplevars.aug.orig
t++++ lenses/tests/test_simplevars.aug
t+@@ -34,3 +34,32 @@
t+      Support empty values *)
t+ test Simplevars.lns get "foo =\n" =
t+   { "foo" = "" { } }
t++
t++(* Variable: bsd_adduser
t++     adduser(8) on the BSDs writes its config as perl, not as shell *)
t++let bsd_adduser = "# verbose = [0-2]
t++verbose = 1
t++
t++# copy dotfiles from this dir (\"/etc/skel\" or \"no\")
t++dotdir = \"/etc/skel\"
t++
t++# List of directories where shells located
t++# path = ('/bin', '/usr/bin', '/usr/local/bin')
t++path = ('/bin', '/usr/bin', '/usr/local/bin')
t++
t++## DO NOT DELETE THIS LINE!
t++"
t++
t++(* Test: Simplevars.lns *)
t++test Simplevars.lns get bsd_adduser =
t++   { "#comment" = "verbose = [0-2]" }
t++   { "verbose" = "1" }
t++   { }
t++   { "#comment" = "copy dotfiles from this dir (\"/etc/skel\" or \"no\")" }
t++   { "dotdir" = "\"/etc/skel\"" }
t++   { }
t++   { "#comment" = "List of directories where shells located" }
t++   { "#comment" = "path = ('/bin', '/usr/bin', '/usr/local/bin')" }
t++   { "path" = "('/bin', '/usr/bin', '/usr/local/bin')" }
t++   { }
t++   { "#comment" = "# DO NOT DELETE THIS LINE!" }
tIndex: sysutils/augeas/patches/patch-man_Makefile.in
t===================================================================
tRCS file: sysutils/augeas/patches/patch-man_Makefile.in
tdiff -u /dev/null sysutils/augeas/patches/patch-man_Makefile.in
t--- /dev/null
t+++ sysutils/augeas/patches/patch-man_Makefile.in
t@@ -0,0 +1,56 @@
t+$NetBSD$
t+
t+Point the manual pages at the configured lens directory.
t+
t+augtool.1, augparse.1, augmatch.1 and augprint.1 all say the lenses live
t+in /usr/share/augeas/lenses.  What the tools search is AUGEAS_LENS_DIR,
t+which src/internal.h builds from DATADIR, which configure sets from
t+$(datadir).  The text is therefore only right when the package was
t+configured with --prefix=/usr, and wrong for pkgsrc: /usr/pkg by default,
t+/opt/pkg on macOS, whatever --prefix says.  There are 15 mentions across
t+the four pages.
t+
t+Rewriting the installed pages rather than the .pod sources keeps the
t+sources readable and needs no extra build step: the substitution has
t+nothing to do until the paths are known, which is at install time.
t+
t+Sent upstream as hercules-team/augeas#892, which adds install-data-hook to
t+man/Makefile.am.  This is the same change in the generated makefile: the
t+hook itself, the line that calls it from install-data-am, and the .PHONY
t+entry, all as automake writes them.
t+
t+--- man/Makefile.in.orig
t++++ man/Makefile.in
t+@@ -1784,6 +1784,8 @@
t+ info-am:
t+ 
t+ install-data-am: install-man
t++	@$(NORMAL_INSTALL)
t++	$(MAKE) $(AM_MAKEFLAGS) install-data-hook
t+ 
t+ install-dvi: install-dvi-am
t+ 
t+@@ -1836,7 +1838,8 @@
t+ .PHONY: all all-am check check-am clean clean-generic clean-libtool \
t+ 	cscopelist-am ctags-am distclean distclean-generic \
t+ 	distclean-libtool distdir dvi dvi-am html html-am info info-am \
t+-	install install-am install-data install-data-am install-dvi \
t++	install install-am install-data install-data-am \
t++	install-data-hook install-dvi \
t+ 	install-dvi-am install-exec install-exec-am install-html \
t+ 	install-html-am install-info install-info-am install-man \
t+ 	install-man1 install-pdf install-pdf-am install-ps \
t+@@ -1851,6 +1854,13 @@
t+ 
t+ %.1: %.pod
t+ 	pod2man -c "Augeas" -r "Augeas $(VERSION)" $< > $@
t++
t++install-data-hook:
t++	@for f in $(man1_MANS); do \
t++	  p=$(DESTDIR)$(man1dir)/$$f; \
t++	  sed -e 's|/usr/share/augeas|$(datadir)/augeas|g' $$p > $$p.tmp \
t++	    && mv -f $$p.tmp $$p; \
t++	done
t+ 
t+ # Tell versions [3.59,3.63) of GNU make to not export all variables.
t+ # Otherwise a system limit (for SysV at least) may be exceeded.
tIndex: sysutils/augeas/patches/patch-src_augtool.c
t===================================================================
tRCS file: sysutils/augeas/patches/patch-src_augtool.c
tdiff -u /dev/null sysutils/augeas/patches/patch-src_augtool.c
t--- /dev/null
t+++ sysutils/augeas/patches/patch-src_augtool.c
t@@ -0,0 +1,24 @@
t+$NetBSD$
t+
t+Print elapsed time with a format that matches time_t.
t+
t+time_t is 64 bits on NetBSD while long is 32 bits on the 32 bit ports, so
t+"%ld" is the wrong conversion and gcc says so:
t+
t+  augtool.c:469:21: warning: format '%ld' expects argument of type 'long int',
t+  but argument 2 has type 'time_t {aka long long int}' [-Wformat=]
t+
t+Cast rather than assume time_t is long long.  Still present upstream, with
t+no issue or pull request open about it; OpenBSD carries the same fix.
t+
t+--- src/augtool.c.orig
t++++ src/augtool.c
t+@@ -466,7 +466,7 @@
t+                              const struct timeval *stop) {
t+     time_t elapsed = (stop->tv_sec - start->tv_sec)*1000
t+                    + (stop->tv_usec - start->tv_usec)/1000;
t+-    printf("Time: %ld ms\n", elapsed);
t++    printf("Time: %lld ms\n", (long long) elapsed);
t+ }
t+ 
t+ static int run_command(const char *line, bool with_timing) {
