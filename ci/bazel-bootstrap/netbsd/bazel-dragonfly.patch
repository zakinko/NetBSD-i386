+#elif defined(__DragonFly__)
+  // DragonFly has no libprocstat, but the kernel answers KERN_PROC_PATHNAME
+  // for the calling process when the pid is given as -1.
+  {
+    int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PATHNAME, -1};
+    char buffer[PATH_MAX] = {};
+    size_t len = sizeof(buffer);
+    if (sysctl(mib, 4, buffer, &len, nullptr, 0) < 0) {
+      BAZEL_DIE(blaze_exit_code::INTERNAL_ERROR)
+          << "sysctl(KERN_PROC_PATHNAME) failed: " << GetLastErrorString();
+    }
+    return string(buffer);
+  }
 #elif defined(__OpenBSD__) || defined(__NetBSD__)
