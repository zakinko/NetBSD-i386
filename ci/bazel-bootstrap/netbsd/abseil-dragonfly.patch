abseil does not recognise DragonFly.  sysinfo.cc falls through to the generic
branch and casts a pthread_t to pid_t, and cctz defines _XOPEN_SOURCE 500,
which on DragonFly hides isblank, wcstof and the wide scanf family from
libstdc++'s headers (runs 35749586358 and 35757966151).  DragonFly derives
from FreeBSD: it has pthread_np.h and the same sysctl, and its headers behave
the same way, so take the FreeBSD arms in both places.

These are the two files of abseil-cpp#2160 that the bootstrap actually needs;
the rest of that PR is not carried here.  CI only.

diff -ur abs/absl/base/internal/sysinfo.cc abs2/absl/base/internal/sysinfo.cc
--- a/absl/base/internal/sysinfo.cc	2026-09-23 02:00:56
+++ b/absl/base/internal/sysinfo.cc	2026-09-23 02:49:56
@@ -30,11 +30,11 @@
 #include <sys/syscall.h>
 #endif
 
-#if defined(__APPLE__) || defined(__FreeBSD__)
+#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__DragonFly__)
 #include <sys/sysctl.h>
 #endif
 
-#ifdef __FreeBSD__
+#if defined(__FreeBSD__) || defined(__DragonFly__)
 #include <pthread_np.h>
 #endif
 
@@ -444,7 +444,7 @@
   return static_cast<pid_t>(tid);
 }
 
-#elif defined(__FreeBSD__)
+#elif defined(__FreeBSD__) || defined(__DragonFly__)
 
 pid_t GetTID() { return static_cast<pid_t>(pthread_getthreadid_np()); }
 
Only in abs2/absl/base/internal: sysinfo.cc.orig
diff -ur abs/absl/time/internal/cctz/src/time_zone_format.cc abs2/absl/time/internal/cctz/src/time_zone_format.cc
--- a/absl/time/internal/cctz/src/time_zone_format.cc	2026-09-23 02:00:57
+++ b/absl/time/internal/cctz/src/time_zone_format.cc	2026-09-23 02:49:56
@@ -19,7 +19,8 @@
 #endif
 
 #if defined(HAS_STRPTIME) && HAS_STRPTIME
-#if !defined(_XOPEN_SOURCE) && !defined(__FreeBSD__) && !defined(__OpenBSD__)
+#if !defined(_XOPEN_SOURCE) && !defined(__FreeBSD__) && !defined(__OpenBSD__) && \
+    !defined(__DragonFly__)
 #define _XOPEN_SOURCE 500  // Exposes definitions for SUSv2 (UNIX 98).
 #endif
 #endif
