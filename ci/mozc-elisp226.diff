diff -urN a/inputmethod/mozc-elisp226/Makefile b/inputmethod/mozc-elisp226/Makefile
--- inputmethod/mozc-elisp226/Makefile
+++ inputmethod/mozc-elisp226/Makefile
@@ -1,9 +1,17 @@
 # $NetBSD: Makefile,v 1.25 2026/08/26 14:37:05 wiz Exp $
 
 PKGNAME=	${EMACS_PKGNAME_PREFIX}${DISTNAME:S/mozc-/mozc-elisp-/}
-PKGREVISION=	46
+PKGREVISION=	47
 CATEGORIES=	inputmethod editors
 
+
+# mozc.el is only a client of mozc_emacs_helper, which in turn talks to
+# mozc_server; without the server, CreateSession succeeds and the first
+# SendKey comes back as session-error.  The version is pinned because
+# the client refuses a server whose version differs, so a >= dependency
+# would be satisfied by mozc-server226 2.29 and still not work.
+DEPENDS+=	mozc-server-${MOZC_VER}{,nb*}:../../inputmethod/mozc-server226
+
 EMACS_MODULES=	base leim
 
 # Package Requires >= 24.3 for cl-lib etc.
