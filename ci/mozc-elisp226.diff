 .include "../../www/curl/buildlink3.mk"
 .include "../../x11/gtk2/buildlink3.mk"
 .include "../../x11/qt5-qtbase/buildlink3.mk"
+.endif
 
 .include "../../lang/python/tool.mk"
 .include "../../mk/atomic64.mk"
