+# mozc_server and mozc_emacs_helper use none of Qt, GTK2, glib2, zinnia
+# or curl; those belong to mozc-tool, mozc-renderer and the handwriting
+# pad.  Building them unconditionally is what makes every package that
+# includes this file USE_X11=yes, mozc-server226 and mozc-elisp226
+# included, even though neither installs anything linked against X11.
+#
+# Which package is being built is asked the way inputmethod/mozc-server
+# already asks it, rather than by a new variable.
+MOZC_GUI_PKGS=	inputmethod/mozc-server226 inputmethod/mozc-elisp226
+
+.if !empty(MOZC_GUI_PKGS:M${PKGPATH})
+MOZC_GYP_ARGS+=	--noqt
+
+SUBST_CLASSES+=		nogtk
+SUBST_STAGE.nogtk=	pre-configure
+SUBST_MESSAGE.nogtk=	Disable the GTK renderer
+SUBST_FILES.nogtk=	gyp/defines.gypi
+SUBST_SED.nogtk=	-e "s/'enable_gtk_renderer%': '1'/'enable_gtk_renderer%': '0'/"
+.endif
+
 do-configure:
 	cd ${WRKSRC} && ${SETENV} ${MAKE_ENV} \
 		${PYTHONBIN} build_mozc.py \
 		gyp \
-		--gypdir=${LOCALBASE}/bin
+		--gypdir=${LOCALBASE}/bin ${MOZC_GYP_ARGS}
 
+.if empty(MOZC_GUI_PKGS:M${PKGPATH})
 .include "../../devel/glib2/buildlink3.mk"
 #.include "../../devel/protobuf/buildlink3.mk"
 # gmock is not used yet...
