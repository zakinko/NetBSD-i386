--- configure.orig	2024-07-04 08:01:06.791975965 +0000
+++ configure	2026-09-23 03:03:58.409377341 +0000
@@ -29092,6 +29092,22 @@
 have_cpu_set_t=yes
 fi
 
+# Without CPU_ALLOC, lib/cpuset.c uses the macros in include/cpuset.h, and
+# those reach into cpu_set_t.__bits.  A libc can have the type without that
+# member -- DragonFly does -- so ask for what the code will actually use.
+ac_fn_check_decl "$LINENO" "CPU_ALLOC" "ac_cv_have_decl_CPU_ALLOC" "
+#include <sched.h>
+
+" "$ac_c_undeclared_builtin_options" "CFLAGS"
+ac_fn_c_check_member "$LINENO" "cpu_set_t" "__bits" "ac_cv_member_cpu_set_t___bits" "
+#include <sched.h>
+
+" "$ac_includes_default"
+if test "x$ac_cv_have_decl_CPU_ALLOC" != xyes \
+   && test "x$ac_cv_member_cpu_set_t___bits" != xyes
+then :
+  have_cpu_set_t=no
+fi
 
  if test "x$have_cpu_set_t" = xyes; then
   HAVE_CPU_SET_T_TRUE=
