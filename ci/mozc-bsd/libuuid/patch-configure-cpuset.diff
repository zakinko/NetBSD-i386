$NetBSD$

Ask whether cpu_set_t has the member the code uses.

HAVE_CPU_SET_T is decided by AC_CHECK_TYPES([cpu_set_t]), which only looks
for the type name, and it is what gates lib/cpuset.c.  When CPU_ALLOC is not
declared, that file uses the macros in include/cpuset.h, and they reach into
cpu_set_t.__bits and __cpu_mask -- names glibc has and another libc need not.

DragonFly has cpu_set_t but neither of those, so the check passes and the
build stops:

  ./include/cpuset.h:43:13: error: '__cpu_mask' undeclared (first use in this
      function); did you mean '__cpumask_t'?
  ./include/cpuset.h:43:37: error: 'cpu_set_t' {aka 'struct <anonymous>'} has
      no member named '__bits'

NetBSD does not define the type at all, so it never reaches here.

This asks for the member as well, and only when CPU_ALLOC is missing, since
that is the only path that needs it.  The conditional moves below the
CPU_ALLOC check so both answers are available.

Proposed upstream; drop this patch once that lands.

--- configure.orig	2024-07-04 08:01:06.791975965 +0000
+++ configure	2026-09-23 03:03:58.409377341 +0000
@@ -29092,6 +29092,22 @@
 have_cpu_set_t=yes
 fi
 
+# Without CPU_ALLOC, lib/cpuset.c uses the macros in include/cpuset.h, and
+# those reach into cpu_set_t.__bits.  A libc can have the type without that
+# member -- DragonFly does -- so ask for what the code will actually use.
+ac_fn_check_decl "$LINENO" "CPU_ALLOC" "ac_cv_have_decl_CPU_ALLOC" "
+#include <sched.h>
+
+" "$ac_c_undeclared_builtin_options" "CFLAGS"
+ac_fn_c_check_member "$LINENO" "cpu_set_t" "__bits" "ac_cv_member_cpu_set_t___bits" "
+#include <sched.h>
+
+" "$ac_includes_default"
+if test "x$ac_cv_have_decl_CPU_ALLOC" != xyes \
+   && test "x$ac_cv_member_cpu_set_t___bits" != xyes
+then :
+  have_cpu_set_t=no
+fi
 
  if test "x$have_cpu_set_t" = xyes; then
   HAVE_CPU_SET_T_TRUE=
