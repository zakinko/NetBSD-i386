diff -ur a/build_tools/util.py b/build_tools/util.py
--- a/build_tools/util.py	2026-09-23 07:53:28
+++ b/build_tools/util.py	2026-09-23 07:53:28
@@ -54,6 +54,23 @@
   return os.name == 'posix' and os.uname()[0] == 'Linux'
 
 
+def GetBSDName():
+  """Returns the uname of the running BSD, or None elsewhere."""
+  if os.name != 'posix':
+    return None
+  name = os.uname()[0]
+  # GhostBSD and HardenedBSD both answer FreeBSD; MidnightBSD does not, but
+  # its kernel runs FreeBSD binaries and its ports are the FreeBSD ones.
+  if name in ('FreeBSD', 'NetBSD', 'OpenBSD', 'DragonFly', 'MidnightBSD'):
+    return name
+  return None
+
+
+def IsBSD():
+  """Returns true if the platform is one of the BSDs."""
+  return GetBSDName() is not None
+
