Give the BSDs a server directory.

GetServerDirectory() names Windows, macOS, Linux and WASM, and says so in a
comment: "If none of the above platforms is specified, the compiler raises an
error because of no return value."  A BSD build stops there.  The BSDs install
the server where Linux does, so they take the same arm; GetDocumentDirectory()
likewise.

This is the 3.33.6089 shape of part of the first commit on zakinko/mozc
bsd-support, where master needs if constexpr instead.  CI only.

--- a/base/system_util.cc	2026-09-23 14:18:59
+++ b/base/system_util.cc	2026-09-23 14:18:59
@@ -454,12 +454,13 @@
   return MacUtil::GetServerDirectory();
 #endif  // __APPLE__
 
-#if defined(__linux__) || defined(__wasm__)
+#if defined(__linux__) || defined(__wasm__) || defined(__FreeBSD__) || \
+    defined(__NetBSD__) || defined(__OpenBSD__) || defined(__DragonFly__)
 #ifndef MOZC_SERVER_DIR
 #define MOZC_SERVER_DIR "/usr/lib/mozc"
 #endif  // MOZC_SERVER_DIR
   return MOZC_SERVER_DIR;
-#endif  // __linux__ || __wasm__
+#endif  // __linux__ || __wasm__ || the BSDs
 
   // If none of the above platforms is specified, the compiler raises an error
   // because of no return value.
@@ -493,7 +494,8 @@
 }
 
 std::string SystemUtil::GetDocumentDirectory() {
-#if defined(__linux__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(__NetBSD__) || \
+    defined(__OpenBSD__) || defined(__DragonFly__)
 
 #ifndef MOZC_DOCUMENT_DIR
 #define MOZC_DOCUMENT_DIR "/usr/lib/mozc/documents"
