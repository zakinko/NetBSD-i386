diff --git a/nt/xemacs.mak b/nt/xemacs.mak
index 3438897..c2e0cb7 100644
--- a/nt/xemacs.mak
+++ b/nt/xemacs.mak
@@ -691,6 +691,10 @@ PROFILE_FLAGS=
 
 !if $(CPLUSPLUS_COMPILE)
 CPLUSPLUS_COMPILE_FLAGS=-TP
+# xemacs.def.in.in is preprocessed as C even when the build is C++, so
+# __cplusplus is not visible there.  config.h.in needs a build-time flag
+# to tell it which inline functions will have an out-of-line definition.
+OPT_DEFINES=$(OPT_DEFINES) -DUSE_CPLUSPLUS
 !else
 CPLUSPLUS_COMPILE_FLAGS=
 !endif
@@ -784,6 +788,7 @@ TEMACS_COMMON_OBJS= \
 	$(OUTDIR)\gui.obj \
 	$(OUTDIR)\gutter.obj \
 	$(OUTDIR)\indent.obj \
+	$(OUTDIR)\inline.obj \
 	$(OUTDIR)\imgproc.obj \
 	$(OUTDIR)\insdel.obj \
 	$(OUTDIR)\intl.obj \
@@ -971,6 +976,39 @@ CONFIG_VALUES = $(BLDLIB_SRC)\config.values
 !endif
 !if [echo LISPDIR>>$(CONFIG_VALUES) && echo "\\$(LISP:\=\\)">>$(CONFIG_VALUES)]
 !endif
+
+# lisp/ellcc.el drives the module compiler and linker, and takes every
+# tool and flag from config.values.  None of the names it reads were
+# written here, so config-value handed it nil and it could not run at
+# all.  The Unix values come from configure; these are the same values
+# as this makefile already uses to build XEmacs itself.
+!if [echo XEMACS_CC>>$(CONFIG_VALUES) && echo "$(CC:\=\\)">>$(CONFIG_VALUES)]
+!endif
+!if [echo XE_CFLAGS>>$(CONFIG_VALUES) && echo "$(CFLAGS:\=\\)">>$(CONFIG_VALUES)]
+!endif
+!if [echo c_switch_all>>$(CONFIG_VALUES) && echo "$(INCLUDES:\=\\)">>$(CONFIG_VALUES)]
+!endif
+!if [echo LDFLAGS>>$(CONFIG_VALUES) && echo "">>$(CONFIG_VALUES)]
+!endif
+# MSVC has no position-independent-code switch; code is relocatable.
+!if [echo dll_cflags>>$(CONFIG_VALUES) && echo "">>$(CONFIG_VALUES)]
+!endif
+!if [echo dll_ld>>$(CONFIG_VALUES) && echo "link.exe">>$(CONFIG_VALUES)]
+!endif
+!if [echo dll_ldflags>>$(CONFIG_VALUES) && echo "-nologo -dll">>$(CONFIG_VALUES)]
+!endif
+# link takes the output name joined to the switch, not as a separate
+# argument the way -o does.
+!if [echo dll_ldo>>$(CONFIG_VALUES) && echo "-out:">>$(CONFIG_VALUES)]
+!endif
+# The import library the xemacs.exe link now produces.  A module
+# resolves the module API against it.
+!if [echo dll_post>>$(CONFIG_VALUES) && echo "$(BLDSRC:\=\\)\\xemacs.lib">>$(CONFIG_VALUES)]
+!endif
+!if [echo configuration>>$(CONFIG_VALUES) && echo "$(EMACS_CONFIGURATION)">>$(CONFIG_VALUES)]
+!endif
+!if [echo version>>$(CONFIG_VALUES) && echo "$(XEMACS_VERSION_STRING)">>$(CONFIG_VALUES)]
+!endif
 !if defined(PATH_LATE_PACKAGE_DIRECTORIES)
 # PATH_LATE_PACKAGE_DIRECTORIES is already a quoted string.
 ! if [echo PATH_LATE_PACKAGE_DIRECTORIES>>$(CONFIG_VALUES) && echo $(PATH_LATE_PACKAGE_DIRECTORIES)>>$(CONFIG_VALUES)]
@@ -1198,8 +1236,10 @@ TEMACS_COMMON_LFLAGS=-nologo $(LIBRARIES) $(DEBUG_FLAGS_LINK) \
  $(PROFILE_FLAGS) setargv.obj
 TEMACS_LFLAGS=$(TEMACS_COMMON_LFLAGS) \
  -pdb:$(BLDSRC)\temacs.pdb -map:$(BLDSRC)\temacs.map
+XEMACS_DEF=$(BLDSRC)\xemacs.def
 XEMACS_LFLAGS=$(TEMACS_COMMON_LFLAGS) \
- -pdb:$(BLDSRC)\xemacs.pdb -map:$(BLDSRC)\xemacs.map
+ -pdb:$(BLDSRC)\xemacs.pdb -map:$(BLDSRC)\xemacs.map \
+ -def:$(XEMACS_DEF) -implib:$(BLDSRC)\xemacs.lib
 
 
 ########################### Definitions for running temacs.exe/xemacs.exe
@@ -1251,6 +1291,29 @@ $(OUTDIR)\temacs.res: $(NT)\xemacs.rc
 
 TEMACS_DUMP_DEP = $(OUTDIR)\dump-id.obj
 
+## src/inline.c, added to TEMACS_COMMON_OBJS above, is the one
+## translation unit that defines each inline function out of line.
+## Without it the module API can name those functions but nothing
+## carries a symbol for the linker to export.
+##
+## src/xemacs.def.in.in names the symbols a dynamic module may use.  On
+## Unix configure runs it through the C preprocessor to produce
+## src/xemacs.def, and src/Makefile.in.in hands that to dlltool.  This
+## build runs neither configure nor that Makefile, so nothing exported
+## the symbols and no import library was produced: a module could be
+## compiled but had nothing to link against.  Preprocess it here.
+##
+## cl picks the language from the suffix, so the source is copied to a
+## .c name first, and the filename cl echoes on stdout is dropped --
+## left in place it would be read as the name of an export.
+
+$(XEMACS_DEF): $(SRC)\xemacs.def.in.in $(SRC)\config.h
+	@copy $(SRC)\xemacs.def.in.in $(BLDSRC)\xemacs_def.c
+	$(CCV) -nologo -EP $(INCLUDES) $(DEFINES) $(BLDSRC)\xemacs_def.c \
+	  > $(BLDSRC)\xemacs_def.tmp
+	findstr /v /b /c:"xemacs_def.c" $(BLDSRC)\xemacs_def.tmp > $@
+	-$(DEL) $(BLDSRC)\xemacs_def.c $(BLDSRC)\xemacs_def.tmp
+
 $(RAW_EXE): $(TEMACS_OBJS) $(TEMACS_DUMP_DEP)
 # Command line too long for some Windows installation:
 #	@echo link $(TEMACS_LFLAGS) -out:$@ $(TEMACS_OBJS) $(TEMACS_DUMP_DEP) $(TEMACS_LIBS)
@@ -1276,7 +1339,7 @@ $(BLDSRC)\NEEDTODUMP:
 # This rule dumps xemacs and then possibly spawns sub-make if PURESPACE
 # requirements have changed.
 
-$(DUMP_TARGET): $(RAW_EXE) $(BLDSRC)\NEEDTODUMP
+$(DUMP_TARGET): $(RAW_EXE) $(BLDSRC)\NEEDTODUMP $(XEMACS_DEF)
 	$(TEMACS_BATCH) -l $(LISP)\loadup.el dump
 	cd $(BLDSRC)
 	rc -d INCLUDE_DUMP -Fo $(OUTDIR)\xemacs.res $(NT)\xemacs.rc
diff --git a/src/config.h.in b/src/config.h.in
index 38db1b6..064e0a9 100644
--- a/src/config.h.in
+++ b/src/config.h.in
@@ -1195,7 +1195,14 @@ extern "C" {
      check whether emacs is defined, since xemacs.def.in is not guaranteed
      to be processed with that set in the preprocessor. Aidan Kehoe, Wed,
      Mar 18, 2020 9:02:12 PM  */
-#if !defined (USE_GPLUSPLUS)
+/* USE_GPLUSPLUS only covers g++, which is the only C++ compiler the
+   Unix build has ever used.  MSVC compiles the whole tree as C++ too
+   whenever error checking is on (nt/xemacs.mak selects -TP), and there
+   __cplusplus makes INLINE_HEADER `inline static' in inline.c as well,
+   so no out-of-line copy exists for the linker to export.  Its link
+   refuses the whole executable rather than shrugging the way dlltool
+   does, which is how this surfaced.  */
+#if !defined (USE_GPLUSPLUS) && !defined (USE_CPLUSPLUS)
 #define XEMACS_DEFS_NEEDS_INLINE_DECLS
 #endif
 
